<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.meloman.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/app_background_light</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/light_green</item>

        <!-- Настройка цветов для компонентов -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Серые цвета для кнопок и фона -->
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/dark_gray</item>
        <item name="colorOutline">@color/gray</item>

        <!-- Цвет для ripple эффекта -->
        <item name="colorControlHighlight">@color/purple_200</item>
    </style>

    <style name="Theme.meloman" parent="Theme.meloman.Base">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="Theme.meloman.NoActionBar" parent="Theme.meloman.Base">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ==================== ГЛОБАЛЬНЫЕ СТИЛИ КНОПОК ==================== -->

    <!-- Стиль для кнопок с контуром (основной стиль) -->
    <style name="GlobalOutlinedButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Стиль для кнопки Play/Pause (заполненная) -->
    <style name="GlobalPlayButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/purple_500</item>
        <item name="elevation">6dp</item>
        <item name="cornerRadius">40dp</item>
        <item name="rippleColor">@color/purple_200</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Стиль для текстовых кнопок (Blacklist) -->
    <style name="GlobalTextButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- ==================== СТИЛИ ДЛЯ КНОПОК IMPORT ==================== -->
    <!-- Стиль для кнопки Import (зеленая) -->
    <style name="ImportButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@android:color/holo_green_dark</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- Стиль для кнопки Import (синяя) -->
    <style name="UpdateButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@android:color/holo_blue_dark</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- Стиль для кнопки Cancel (красная) -->
    <style name="CancelButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@android:color/holo_red_dark</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>