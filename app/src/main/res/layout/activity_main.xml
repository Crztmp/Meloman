<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="8dp"
    tools:context=".MainActivity">

    <!-- Верхняя панель (без изменений) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRandom"
            style="@style/GlobalOutlinedButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="0dp"
            app:icon="@drawable/ic_random"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnSurface" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            style="@style/GlobalOutlinedButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="2dp"
            android:padding="0dp"
            app:icon="@drawable/ic_volume_up"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnSurface" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/GlobalOutlinedButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="0dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            style="@style/GlobalOutlinedButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="2dp"
            android:padding="0dp"
            app:icon="@drawable/ic_exit"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Область плеера -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvPlaylistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_playlist"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:gravity="start"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnSurface"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="0dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCurrentFolder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/folder_none"
                            android:textSize="16sp"
                            android:padding="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton android:layout_height="48dp"
                            android:layout_width="wrap_content"
                            android:textSize="18sp"
                            android:text="📁 → 🚫"
                            style="@style/GlobalOutlinedButtonStyle"
                            android:id="@+id/btnBlacklistFolder"
                            android:paddingEnd="12dp"
                            android:paddingStart="12dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCurrentTrack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/no_track_playing"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="48dp"
                            android:layout_width="wrap_content"
                            android:textSize="18sp"
                            android:text="📄 → 🚫"
                            style="@style/GlobalOutlinedButtonStyle"
                            android:id="@+id/btnBlacklistTrack"
                            android:paddingEnd="12dp"
                            android:paddingStart="12dp"/>

                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbTrackProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="0dp">

                        <TextView
                            android:id="@+id/tvCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="00:00"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvRemainingTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="-00:00"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvDurationTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="00:00"
                            android:textSize="10sp"
                            android:gravity="end"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <!-- Кнопки управления с новыми иконками -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevFolder"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_folder_previous"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevTrack"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_track_previous"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_play"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_stop"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextTrack"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_track_next"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextFolder"
                    style="@style/GlobalOutlinedButtonStyle"
                    android:layout_width="0dp"
                    android:maxHeight="80dp"
                    android:minHeight="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_control_folder_next"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    app:iconTint="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Отладка и нижняя строка -->
    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ready"
        android:textSize="9sp"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="0dp">

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meloman 1.0.0"
            android:textSize="9sp"
            android:gravity="start"
            android:textColor="?attr/colorOnSurface" />



        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" by CrazySoft"
            android:textSize="9sp"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

</LinearLayout>